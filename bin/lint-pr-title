#!/usr/bin/env bash
# Check that a pull request title is a Conventional Commit subject: the merge
# commit carries the title, and bin/release reads it to pick the version bump
# and write the changelog entry.
#
# Usage: lint-pr-title "feat(orm): add a thing"
#        lint-pr-title --bitbucket   # read the title of $BITBUCKET_PR_ID via the API
#
# --bitbucket needs a repository access token with "Pull requests: Read" in
# DRY_CI_BITBUCKET_TOKEN.
set -euo pipefail

TYPES="feat|fix|perf|refactor|docs|test|build|ci|chore|style|revert"

bitbucket_title() {
  : "${BITBUCKET_PR_ID:?not a pull request pipeline}"
  : "${BITBUCKET_REPO_FULL_NAME:?}"
  : "${DRY_CI_BITBUCKET_TOKEN:?set a repository access token in DRY_CI_BITBUCKET_TOKEN}"
  local json
  json="$(curl -fsSL -H "Authorization: Bearer $DRY_CI_BITBUCKET_TOKEN" \
    "https://api.bitbucket.org/2.0/repositories/$BITBUCKET_REPO_FULL_NAME/pullrequests/$BITBUCKET_PR_ID")"
  if command -v python3 >/dev/null; then
    python3 -c 'import json, sys; print(json.load(sys.stdin)["title"])' <<< "$json"
  else
    php -r 'echo json_decode(stream_get_contents(STDIN), true)["title"], "\n";' <<< "$json"
  fi
}

case "${1:-}" in
  --bitbucket) title="$(bitbucket_title)" ;;
  "" | -h | --help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
  *) title="$1" ;;
esac

MARKER_RE='\[(major|minor|patch|no release)\]'

fail() {
  cat >&2 <<EOF
$1

  $title

Use "<type>(<optional scope>): <description>". Types: ${TYPES//|/, }.
Mark a breaking change with ! before the colon: the title is what counts, a
BREAKING CHANGE footer in a branch commit is not read. One marker at the end
sets the release, whatever the type.
  feat(orm): add record subpages          -> minor release
  fix: keep 2FA trust on logout           -> patch release
  feat(admin)!: drop the legacy sidebar   -> major release
  fix(api): reject an empty limit [major] -> major release, a breaking change
  fix(api): accept a limit [minor]        -> minor release
  feat(admin): add CSV export [patch]     -> patch release
  docs: explain the setup [no release]    -> no release; goes out with the next
EOF
  exit 1
}

# A release marker, read by cliff.toml (bump) and bin/release ([no release]).
subject="$title"
marker=""
if [[ "$title" =~ \ $MARKER_RE$ ]]; then
  marker="${BASH_REMATCH[1]}"
  subject="${title% \[*\]}"
fi
shopt -s nocasematch
[[ "$subject" =~ $MARKER_RE ]] &&
  fail "PR title has a release marker that isn't at the end, in lower case, or has more than one:"
shopt -u nocasematch

[[ "$subject" =~ ^($TYPES)(\([^\)]+\))?(!?):\ [^[:space:]] ]] ||
  fail "PR title is not a Conventional Commit subject:"
if [[ "${BASH_REMATCH[3]}" == "!" && ( "$marker" == minor || "$marker" == patch ) ]]; then
  fail "PR title is breaking (!) but asks for a $marker release:"
fi

echo "PR title ok: $title"
