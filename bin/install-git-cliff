#!/usr/bin/env bash
# Download the pinned git-cliff release, check its checksum and print the
# binary's path. Usage: install-git-cliff [DIR]  (default: <dry-ci>/.bin)
set -euo pipefail

VERSION="2.14.2"
DRY_CI_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
dir="${1:-$DRY_CI_ROOT/.bin}"

case "$(uname -s)-$(uname -m)" in
  Linux-x86_64)
    target=x86_64-unknown-linux-gnu
    sha512=26d1f7c8ea2400f2ccb0b2e7f321635f600b583bf4cd1f7afaa5e8c24068ad1088a2504e0a4d9f4333d4bb20a80329327d9462634343ee3af91e1a7fbdc6f18a ;;
  Linux-aarch64 | Linux-arm64)
    target=aarch64-unknown-linux-gnu
    sha512=fd27768ea76fea8c3ba3f3247fef2f6604988b629f15e48bf40be5eaa08b8fef2e4087cc9c8af16bc522bc19cc369611fa7692101b513f63469ad58522708600 ;;
  Darwin-x86_64)
    target=x86_64-apple-darwin
    sha512=4d32c50a010cbff65e46f1f36347c2dd1a20f17efea7b77115d3166146ad467dc803cd07b839fc35e0a6639aa8d1af9eab7cf8f7984bcd819513f46a396ff801 ;;
  Darwin-arm64)
    target=aarch64-apple-darwin
    sha512=6ec30660233fcd73b92e9d888965945b6435d6fcd7120df8d7c0799faa46cf06d563d49de721ccf4387e6d61bdc5b37c8eb73273c7d9a0883b90cd9857c6ad9f ;;
  *) echo "install-git-cliff: unsupported platform $(uname -s)-$(uname -m)" >&2; exit 1 ;;
esac

bin="$dir/git-cliff"
if [[ -x "$bin" ]] && "$bin" --version 2>/dev/null | grep -q " $VERSION\$"; then
  echo "$bin"
  exit 0
fi

archive="git-cliff-$VERSION-$target.tar.gz"
tmp="$(mktemp -d "${TMPDIR:-/tmp}/git-cliff.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT

curl -fsSL -o "$tmp/$archive" \
  "https://github.com/orhun/git-cliff/releases/download/v$VERSION/$archive"

if command -v sha512sum >/dev/null; then
  actual="$(sha512sum "$tmp/$archive" | cut -d' ' -f1)"
else
  actual="$(shasum -a 512 "$tmp/$archive" | cut -d' ' -f1)"
fi
if [[ "$actual" != "$sha512" ]]; then
  echo "install-git-cliff: checksum mismatch for $archive" >&2
  exit 1
fi

tar -xzf "$tmp/$archive" -C "$tmp"
mkdir -p "$dir"
install -m 0755 "$tmp/git-cliff-$VERSION/git-cliff" "$bin"
echo "$bin"
